// RUN: %target-sil-opt -enable-sil-verify-all %s -mandatory-allocbox-to-stack -diagnose-static-exclusivity | %FileCheck %s
// RUN: %target-sil-opt -enable-sil-verify-all %s -mandatory-allocbox-to-stack -diagnose-static-exclusivity -sil-verify-around-pass=mandatory-allocbox-to-stack,diagnose-static-exclusivity | %FileCheck %s
// RUN: %target-sil-opt %s -mandatory-allocbox-to-stack -diagnose-static-exclusivity -sil-print-closure-groups -o /dev/null 2>&1 | %FileCheck %s --check-prefix=GROUPS
// RUN: %target-sil-opt %s -mandatory-allocbox-to-stack -diagnose-static-exclusivity -sil-print-after=mandatory-allocbox-to-stack -sil-print-function='$s7closureTf0s_n' -o /dev/null 2>&1 | %FileCheck %s --check-prefix=PRINT

// MandatoryAllocBoxToStack and DiagnoseStaticExclusivity run as one closure
// group block. MandatoryAllocBoxToStack specializes the closure that takes the
// box, and erases the original once nothing refers to it. The specialization
// joins the group, and the erased original leaves it, so
// DiagnoseStaticExclusivity runs on the specialization only.

// GROUPS:      Closure group for mandatory-allocbox-to-stack: closure parent{{$}}
// GROUPS-NEXT: Closure group for diagnose-static-exclusivity: $s7closureTf0s_n parent{{$}}

// PRINT:      *** SIL function after {{.*}} pass 0: MandatoryAllocBoxToStack (mandatory-allocbox-to-stack)
// PRINT:      sil private [ossa] @$s7closureTf0s_n : $@convention(thin) (@inout_aliasable Builtin.Int64) -> Builtin.Int64 {
// PRINT:      } // end sil function '$s7closureTf0s_n'

sil_stage raw

import Builtin
import Swift

// CHECK-NOT:   @closure :
// CHECK-LABEL: sil private [ossa] @$s7closureTf0s_n : $@convention(thin) (@inout_aliasable Builtin.Int64) -> Builtin.Int64 {
// CHECK-LABEL: } // end sil function '$s7closureTf0s_n'
// CHECK-NOT:   @closure :
sil private [ossa] @closure : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> Builtin.Int64 {
bb0(%0 : @closureCapture @guaranteed ${ var Builtin.Int64 }):
  %1 = project_box %0, 0
  %2 = begin_access [read] [unknown] %1
  %3 = load [trivial] %2
  end_access %2
  return %3
}

// CHECK-LABEL: sil [ossa] @parent : $@convention(thin) (Builtin.Int64) -> Builtin.Int64 {
// CHECK:         alloc_stack
// CHECK:         [[SPEC:%.*]] = function_ref @$s7closureTf0s_n
// CHECK:         apply [[SPEC]](
// CHECK-LABEL: } // end sil function 'parent'
sil [ossa] @parent : $@convention(thin) (Builtin.Int64) -> Builtin.Int64 {
bb0(%0 : $Builtin.Int64):
  %1 = alloc_box ${ var Builtin.Int64 }
  %2 = project_box %1, 0
  store %0 to [trivial] %2
  %4 = function_ref @closure : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> Builtin.Int64
  %5 = apply %4(%1) : $@convention(thin) (@guaranteed { var Builtin.Int64 }) -> Builtin.Int64
  destroy_value %1
  return %5
}
