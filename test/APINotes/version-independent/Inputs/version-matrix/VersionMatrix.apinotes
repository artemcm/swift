Name: VersionMatrix

Functions:
  - Name: nameU
    SwiftName: 'nameU_unversioned()'
  - Name: nameUV
    SwiftName: 'nameUV_unversioned()'
  - Name: nameHeader
    SwiftName: 'nameHeader_fromNotes()'
  - Name: nameKeylessV4
    SwiftName: 'nameKeylessV4_unversioned()'
  - Name: privU
    SwiftPrivate: true
  - Name: privHeaderUndoneU
    SwiftPrivate: false
  - Name: availNonswiftU
    Availability: nonswift
    AvailabilityMsg: 'not in Swift, unversioned'
  - Name: availNoneU
    Availability: none
    AvailabilityMsg: 'gone everywhere'

Globals:
  - Name: globalNameU
    SwiftName: globalNameU_unversioned

Enumerators:
  - Name: EnumeratorNamesU
    SwiftName: enumeratorU_unversioned
  - Name: EnumeratorNamesUV
    SwiftName: enumeratorUV_unversioned

Typedefs:
  - Name: WrapperStructU
    SwiftWrapper: struct

Tags:
  - Name: EnumOpenU
    EnumKind: NSEnum

Classes:
  - Name: MatrixClass
    Properties:
      - Name: accessorsU
        PropertyKind: Instance
        SwiftImportAsAccessors: true
    Methods:
      - Selector: 'initWithDesignatedU:'
        MethodKind: Instance
        DesignatedInit: true
      - Selector: categoryMethodU
        MethodKind: Instance
        SwiftName: 'categoryMethodU_unversioned()'
  - Name: MatrixMembersU
    SwiftObjCMembers: true

Protocols:
  - Name: MatrixProtocolU
    SwiftName: MatrixProtocolU_unversioned
    Methods:
      - Selector: protocolMethodU
        MethodKind: Instance
        SwiftName: 'protocolMethodU_unversioned()'

SwiftVersions:
  - Version: 4
    Functions:
      # Rename that only a 4.0 client sees.
      - Name: nameV4
        SwiftName: 'nameV4_fromNotes()'
      # Both slices rename: the 4.0 one has to win at or below 4.
      - Name: nameUV
        SwiftName: 'nameUV_v4()'
      # A 4.0 rename over one written in the header.
      - Name: nameHeaderV4
        SwiftName: 'nameHeaderV4_fromNotes()'
      # Names the function but sets no key, so selecting it at or below 4.0
      # suppresses the unversioned rename.
      - Name: nameKeylessV4
      - Name: privV4
        SwiftPrivate: true
      # Undo a header-written swift_private for 4.0 clients only.
      - Name: privHeaderUndoneV4
        SwiftPrivate: false
      - Name: availNonswiftV4
        Availability: nonswift
        AvailabilityMsg: 'not in Swift at 4.0'
    Tags:
      - Name: EnumFlagV4
        EnumKind: NSOptions
      # Key-less slice on a tag.
      - Name: EnumClosedKeyless
    Classes:
      - Name: MatrixClass
        Properties:
          - Name: accessorsV4
            PropertyKind: Instance
            SwiftImportAsAccessors: true
          - Name: categoryAccessorsV4
            PropertyKind: Instance
            SwiftImportAsAccessors: true
        Methods:
          - Selector: 'methodPrivateV4'
            MethodKind: Instance
            SwiftPrivate: true
          # A category member, annotated through the class it extends.
          - Selector: categoryMethodV4
            MethodKind: Instance
            SwiftName: 'categoryMethodV4_v4()'
      - Name: MatrixNonGenericV4
        SwiftImportAsNonGeneric: true
    Protocols:
      - Name: MatrixProtocolV4
        SwiftName: MatrixProtocolV4_v4
      - Name: MatrixProtocolU
        Methods:
          - Selector: protocolMethodV4
            MethodKind: Instance
            SwiftName: 'protocolMethodV4_v4()'
    Globals:
      - Name: globalNameV4
        SwiftName: globalNameV4_v4
      - Name: globalPrivV4
        SwiftPrivate: true
    Enumerators:
      - Name: EnumeratorNamesV4
        SwiftName: enumeratorV4_v4
      - Name: EnumeratorNamesUV
        SwiftName: enumeratorUV_v4
    Typedefs:
      - Name: WrapperEnumV4
        SwiftWrapper: enum
      # Takes away the header's swift_wrapper for 4.0 clients.
      - Name: WrapperNoneV4
        SwiftWrapper: none
      - Name: TypedefNameV4
        SwiftName: TypedefNameV4_v4

  - Version: 5
    Functions:
      # A 5.0 slice that a 4.0 client must not select, and a 5.0 client must.
      - Name: nameU
        SwiftName: 'nameU_v5()'
    Tags:
      - Name: EnumClosedKeyless
        EnumKind: NSClosedEnum

  # Versions a Swift 4.2 and a Swift 6 client select, and nobody below.
  - Version: 4.2
    Functions:
      - Name: nameV42
        SwiftName: 'nameV42_v42()'
  - Version: 6
    Functions:
      - Name: nameV6
        SwiftName: 'nameV6_v6()'
